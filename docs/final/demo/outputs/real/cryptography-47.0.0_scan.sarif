          "ruleId": "pqscan/abstain/pk_decrypt",
          "level": "note",
          "message": {
            "text": "ANY PK_DECRYPT [T0] -> ABSTAIN: Evidence tier T0 is below the policy threshold T2: the receiver is not resolved to a key object and no algorithm-specific argument is visible. Inferred role (not acted on): PK_DECRYPT."
          },
          "locations": [
            {
              "physicalLocation": {
