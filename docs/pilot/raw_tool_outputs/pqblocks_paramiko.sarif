              "fullDescription": {
                "text": "Legacy classical algorithms (RSA, ECC, ECDSA, ECDH) are vulnerable to Shor's algorithm."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://csrc.nist.gov/pubs/ir/8547/ipd"
            },
