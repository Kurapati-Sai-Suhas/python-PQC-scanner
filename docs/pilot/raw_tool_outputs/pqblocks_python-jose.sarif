              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://csrc.nist.gov/pubs/ir/8547/ipd"
            },
            {
              "id": "PQC002",
              "name": "ClassicallyBrokenPrimitive",
              "shortDescription": {
                "text": "Classically broken or prohibited cryptographic algorithm"
              },
              "fullDescription": {
