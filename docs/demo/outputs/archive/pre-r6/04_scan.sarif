            "targetClass": "ABSTAIN",
            "policyVersion": "1.1",
            "scope": "app"
          }
        },
        {
          "ruleId": "pqscan/abstain/unknown",
          "level": "note",
          "message": {
            "text": "RSA UNKNOWN [T2] -> ABSTAIN: Role cannot be determined: key material (RSA) reaches consumers of 2 families (PKE, SIG); the role depends on which path runs, so it is not statically determinable. Possible roles: PK_DECRYPT, SIGN, VERIFY. No single target is justified."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
