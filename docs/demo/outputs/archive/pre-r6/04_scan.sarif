          }
        },
        {
          "ruleId": "pqscan/recommend/sign",
          "level": "warning",
          "message": {
            "text": "RSA SIGN [T2] -> SIG: RSA signing is deprecated after 2030 and disallowed after 2035 (NIST IR 8547 Table 2). Migrate signing to ML-DSA (FIPS 204); dual/hybrid signatures are a transitional option; verifiers and certificate chains must be able to accept ML-DSA before signers switch."
          },
          "locations": [
