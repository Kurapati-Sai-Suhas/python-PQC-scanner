          "ruleId": "pqscan/abstain/sign",
          "level": "note",
          "message": {
            "text": "ANY SIGN [T0] -> ABSTAIN: Evidence tier T0 is below the policy threshold T2: the receiver is not resolved to a key object and no algorithm-specific argument is visible. Inferred role (not acted on): SIGN."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ambiguous.py"
